---
import Layout from "../layouts/default.astro";
import { supabase } from "../lib/supabase";
import { ogImageUrl } from "../lib/og";
import dayjs from "dayjs";
const title = "Jenuel Dev — Programming & Finance Blog for Developers";
const description =
    "Practical articles by Jenuel Ganawed about software development, AI tools, developer productivity, programming, and personal finance for people in tech.";

const SITE = "https://blog.jenuel.dev";

// Self-hosted so the logo can't disappear out from under the structured data
// the way a hotlinked image host can.
const LOGO = `${SITE}/logo.png`;

// sameAs is how Google reconciles this site with the person behind it, so every
// entry has to resolve. The previous github.com/BrockenDuck entry was a 404 and
// pointed the graph at an account that doesn't exist.
const PROFILES = [
    "https://www.jenuel.dev",
    "https://github.com/JenuelDev",
    "https://www.linkedin.com/in/jenuelganawed/",
    "https://stackoverflow.com/users/8830054/jenuel-ganawed",
    "https://dev.to/jenueldev",
    "https://gravatar.com/jenueldev",
    "https://www.youtube.com/@JenuelGanawed",
    "https://twitter.com/JenuelDev",
    "https://www.instagram.com/brojenuel/",
];

// Homepage JSON-LD: identifies the site and its author for Google's knowledge
// graph / sitelinks. sameAs lists the canonical profiles that represent the brand.
const homeJsonLd = [
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "Jenuel Dev",
        alternateName: "JenuelDev Blogs",
        url: "https://blog.jenuel.dev",
        description: description,
        inLanguage: "en",
    },
    {
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Jenuel Oras Ganawed",
        url: "https://www.jenuel.dev",
        image: "https://www.jenuel.dev/profile_image.webp",
        jobTitle: "Software Developer",
        sameAs: PROFILES,
    },
    {
        // Matches the `publisher` used in each post's BlogPosting schema, so
        // Google resolves them to the same entity.
        "@context": "https://schema.org",
        "@type": "Organization",
        name: "Jenuel Dev",
        url: "https://blog.jenuel.dev",
        logo: {
            "@type": "ImageObject",
            url: LOGO,
        },
        sameAs: PROFILES,
    },
];

    const limit = 50;

const { data, error } = await supabase
    .from("blogs")
    .select(`id, title, summary, slug, updated_at, cover_img, blog_meta(*), tags`)
    .eq("is_active", 1)
    .order("id", { ascending: false })
    .limit(limit);

if (error) {
    console.log(error);
}

const blogs = data ?? [];

// This page is the canonical article listing (/blog canonicals here), so the
// Blog + blogPost feed belongs on it. Lets Google read the listing as a feed of
// articles rather than a wall of anchor tags.
homeJsonLd.push({
    "@context": "https://schema.org",
    "@type": "Blog",
    name: "Jenuel Dev Blog",
    description: description,
    url: SITE,
    inLanguage: "en",
    publisher: {
        "@type": "Organization",
        name: "Jenuel Dev",
        url: SITE,
        logo: { "@type": "ImageObject", url: LOGO },
    },
    blogPost: blogs.map((blog: any) => ({
        "@type": "BlogPosting",
        headline: blog.title,
        description: blog.summary,
        url: `${SITE}/blog/${blog.slug}`,
        dateModified: blog.updated_at,
        image: blog.cover_img ?? undefined,
    })),
} as any);

// Guard against a stray "</script>" in post titles breaking the tag.
const homeJsonLdString = JSON.stringify(homeJsonLd).replace(/</g, "\\u003c");
---

<Layout
    title={title}
    titleTemplate="%s"
    description={description}
    image={ogImageUrl(title, description)}
>
    <Fragment slot="head">
        <script type="application/ld+json" is:inline set:html={homeJsonLdString} />
    </Fragment>
    <main>
        <div class="flex flex-col gap-5 w-full max-w-800px mx-auto px-5 pt-28">
            <header class="pb-5">
                <h1 class="text-5xl font-bold">Programming and finance for developers</h1>
                <p class="text-secondary mt-3">{description}</p>
            </header>
            {
                blogs.map((blog) => (
                    <>
                        <a href={`/blog/${blog.slug}`} class="flex sm:flex-row flex-col gap-5 group">
                            <div class="content-summary leading-5 col-span-6 ">
                                <div class="text-xs sm:mb-1 text-secondary">
                                    {dayjs(blog.updated_at).format("DD MMM, YYYY")}
                                </div>
                                <div class="sm:mb-2 text-2xl group-hover:underline underline-[var(--slate10)]">
                                    {blog.title}
                                </div>
                                <p class={`line-clamp-6 text-sm ${blog.cover_img && "line-clamp-3"} text-secondary`}>
                                    {blog.summary}
                                </p>
                            </div>
                        </a>
                    </>
                ))
            }
        </div>
    </main>
</Layout>
