---
import Layout from "../../layouts/default.astro";
import { supabase } from "../../lib/supabase";
import { ogImageUrl } from "../../lib/og";
import dayjs from "dayjs";

const limit = 50;

const { data, error } = await supabase
    .from("blogs")
    .select(`id, title, summary, slug, updated_at, cover_img, blog_meta(*), tags`)
    .eq("is_active", 1)
    .order("id", { ascending: false })
    .limit(limit);

if (error) {
    console.log(error);
}
const blogs = data ?? [];
const SITE = "https://blog.jenuel.dev";
const title = "Blog";
const description =
    "Articles by Jenuel Ganawed on software development, AI tooling, programming practice, developer productivity, and personal finance for people in tech.";

// This page runs the same query as the homepage and renders the same 50 posts,
// so it's a duplicate of "/". Point the canonical at the homepage to
// consolidate ranking signals there; the URL keeps working for anyone who has
// it bookmarked or linked. The Blog + blogPost structured data lives on the
// homepage for the same reason — it belongs on the canonical URL.
const CANONICAL = `${SITE}/`;
---

<Layout
    title={title}
    description={description}
    canonical={CANONICAL}
    image={ogImageUrl(title, description)}
>
    <section class="w-full max-w-800px mx-auto px-5 sm:text-lg pt-15">
        <h1 class="text-7xl font-bold pt-10 pb-15">Blogs</h1>
        <div class="flex flex-col gap-5">
            {
                blogs.map((blog) => (
                    <>
                        <a href={`/blog/${blog.slug}`} class="flex sm:flex-row flex-col gap-5 group">
                            <div class="content-summary leading-5 col-span-6 ">
                                <div class="text-xs sm:mb-1 text-secondary">
                                    {dayjs(blog.updated_at).format("DD MMM, YYYY")}
                                </div>
                                <div class="sm:mb-2 text-2xl group-hover:underline underline-[var(--slate10)]">
                                    {blog.title}
                                </div>
                                <p class={`line-clamp-6 text-sm ${blog.cover_img && "line-clamp-3"} text-secondary`}>
                                    {blog.summary}
                                </p>
                            </div>
                        </a>
                    </>
                ))
            }
        </div>
    </section>
</Layout>
