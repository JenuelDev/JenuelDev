---
export const prerender = true;
import Layout from "../layouts/default.astro";
import { supabase } from "../lib/supabase";
import dayjs from "dayjs";
const title = "Programming blog for developers";
const description =
    "Practical programming articles on web development, software engineering, developer tools, and becoming a better programmer.";

    const limit = 50;

const { data, error } = await supabase
    .from("blogs")
    .select(`id, title, summary, slug, updated_at, cover_img, blog_meta(*), tags`)
    .eq("is_active", 1)
    .ilike("keywords_str", '%programming%')
    .order("id", { ascending: false })
    .limit(limit);

if (error) {
    console.log(error);
}

const blogs = data ?? [];
const collectionJsonLd = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description,
    url: "https://blog.jenuel.dev/programming",
    mainEntity: {
        "@type": "ItemList",
        itemListElement: blogs.map((blog, index) => ({
            "@type": "ListItem",
            position: index + 1,
            name: blog.title,
            url: `https://blog.jenuel.dev/blog/${blog.slug}`,
        })),
    },
}).replace(/</g, "\\u003c");
---

<Layout
    title={title}
    description={description}
>
    <Fragment slot="head">
        <script type="application/ld+json" is:inline set:html={collectionJsonLd} />
    </Fragment>
    <main>
        <div class="flex flex-col gap-5 w-full max-w-800px mx-auto px-5 pt-28">
            <h1 class="text-5xl font-bold pb-5">Programming articles</h1>
            {
                blogs.map((blog) => (
                    <>
                        <a href={`/blog/${blog.slug}`} class="flex sm:flex-row flex-col gap-5 group">
                            <div class="content-summary leading-5 col-span-6 ">
                                <div class="text-xs sm:mb-1 text-secondary">
                                    {dayjs(blog.updated_at).format("DD MMM, YYYY")}
                                </div>
                                <div class="sm:mb-2 text-2xl group-hover:underline underline-[var(--slate10)]">
                                    {blog.title}
                                </div>
                                <p class={`line-clamp-6 text-sm ${blog.cover_img && "line-clamp-3"} text-secondary`}>
                                    {blog.summary}
                                </p>
                            </div>
                        </a>
                    </>
                ))
            }
        </div>
    </main>
</Layout>
