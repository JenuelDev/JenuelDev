---
export const prerender = true;
import Layout from "../layouts/default.astro";
import { supabase } from "../lib/supabase";
import ArticleListing from "../components/ArticleListing.astro";
const title = "Programming blog for developers";
const description =
    "Practical programming articles on web development, software engineering, developer tools, and becoming a better programmer.";

const limit = 50;

const { data, error } = await supabase
    .from("blogs")
    .select(`id, title, summary, slug, updated_at, cover_img, blog_meta(*), tags`)
    .eq("is_active", 1)
    .ilike("keywords_str", '%programming%')
    .order("id", { ascending: false })
    .limit(limit);

if (error) {
    console.log(error);
}

const blogs = data ?? [];
const collectionJsonLd = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description,
    url: "https://blog.jenuel.dev/programming",
    mainEntity: {
        "@type": "ItemList",
        itemListElement: blogs.map((blog, index) => ({
            "@type": "ListItem",
            position: index + 1,
            name: blog.title,
            url: `https://blog.jenuel.dev/blog/${blog.slug}`,
        })),
    },
}).replace(/</g, "\\u003c");
---

<Layout
    title={title}
    description={description}
>
    <Fragment slot="head">
        <script type="application/ld+json" is:inline set:html={collectionJsonLd} />
    </Fragment>
    <ArticleListing blogs={blogs} category="programming" unavailable={Boolean(error)} />
</Layout>
