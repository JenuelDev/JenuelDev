---
const columns = [
    { title: "Journal", links: [
        { label: "All articles", href: "/" },
        { label: "Programming", href: "/programming" },
        { label: "Finance", href: "/finance" },
        { label: "RSS feed", href: "/rss.xml" },
    ] },
    { title: "Explore", links: [
        { label: "Portfolio", href: "https://www.jenuel.dev/" },
        { label: "Selected work", href: "https://www.jenuel.dev/#projects" },
        { label: "Store", href: "https://store.jenuel.dev/" },
        { label: "Privacy policy", href: "/privacy-policy" },
    ] },
    { title: "Connect", links: [
        { label: "GitHub", href: "https://github.com/JenuelDev" },
        { label: "LinkedIn", href: "https://www.linkedin.com/in/jenuelganawed/" },
        { label: "YouTube", href: "https://www.youtube.com/@JenuelGanawed" },
        { label: "Contact", href: "https://www.jenuel.dev/contact" },
    ] },
];
---

<footer class="craft-footer">
    <div class="craft-footer-inner">
        <div class="craft-footer-grid">
            <div class="craft-footer-brand">
                <a href="/" class="footer-wordmark" aria-label="JenuelDev blog home">
                    <span class="site-logo-mark" aria-hidden="true"></span>
                </a>
                <p>Notes on software, tools, and personal finance. Written by Jenuel Ganawed, from the workbench.</p>
                <a href="mailto:me@jenuel.dev">me@jenuel.dev</a>
            </div>
            {columns.map((column) => (
                <div>
                    <h3>{column.title}</h3>
                    <ul>{column.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
                </div>
            ))}
        </div>
        <div class="craft-footer-bottom">
            <span>&copy; {new Date().getFullYear()} Jenuel Ganawed</span>
            <span>Built with care in the Philippines</span>
        </div>
    </div>
</footer>
