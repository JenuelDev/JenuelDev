---
import { themes } from "../lib/themes";
---

<script is:inline define:vars={{ themes }}>
    // Run before the stylesheet paints, including after an Astro page swap.
    function applyBlogTheme() {
        var accent = "artcraft";
        try { accent = localStorage.getItem("accent") || accent; } catch {}
        var selected = themes.find(function (theme) { return theme.id === accent; }) || themes[0];
        document.documentElement.dataset.accent = selected.id;
        document.documentElement.classList.toggle("dark", selected.dark);
        document.documentElement.style.colorScheme = selected.dark ? "dark" : "light";
    }
    applyBlogTheme();
    document.addEventListener("astro:after-swap", applyBlogTheme);
</script>
