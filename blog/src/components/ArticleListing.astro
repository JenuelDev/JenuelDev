---
import { Icon } from "astro-icon/components";
import dayjs from "dayjs";

interface Article {
    id: string | number;
    title: string;
    summary: string | null;
    slug: string;
    updated_at: string;
}
interface Props {
    blogs: Article[];
    category?: "all" | "programming" | "finance";
    unavailable?: boolean;
}
const { blogs, category = "all", unavailable = false } = Astro.props;
const headings = {
    all: { first: "Notes from", second: "the workbench.", description: "Practical articles on software development, AI tools, developer productivity, and personal finance for people in tech." },
    programming: { first: "On building", second: "better software.", description: "Programming, AI tools, and lessons from building software. Practical ideas to take back to your own workbench." },
    finance: { first: "Beyond code,", second: "a better future.", description: "Personal finance for people in tech. Thoughts on managing money, growing your earnings, and building a more secure future." },
};
const heading = headings[category];
const topics = [
    { id: "all", label: "All articles", href: "/" },
    { id: "programming", label: "Programming", href: "/programming" },
    { id: "finance", label: "Finance", href: "/finance" },
];
---

<main class="journal-page">
    <header class="journal-hero">
        <p class="journal-eyebrow">Jenuel Ganawed / Journal</p>
        <h1>{heading.first} <em>{heading.second}</em></h1>
        <div class="journal-intro">
            <p>{heading.description}</p>
            <a href="https://www.jenuel.dev/">Meet the developer <Icon name="tabler:arrow-up-right" /></a>
        </div>
    </header>
    <section class="journal-entries" aria-labelledby="articles-heading">
        <div class="journal-index">
            <h2 id="articles-heading">01 / {category === "all" ? "Latest writing" : `${category} articles`}</h2>
            <a href="/rss.xml">RSS feed <Icon name="tabler:rss" /></a>
        </div>
        <nav class="journal-topics" aria-label="Article categories">
            {topics.map((topic) => (
                <a href={topic.href} aria-current={topic.id === category ? "page" : undefined}>{topic.label}</a>
            ))}
        </nav>
        <div class="journal-grid">
            {blogs.map((blog) => (
                <article class="journal-card">
                    <a href={`/blog/${blog.slug}`}>
                        <time datetime={blog.updated_at}>{dayjs(blog.updated_at).format("DD MMM, YYYY")}</time>
                        <h3>{blog.title}</h3>
                        <p>{blog.summary}</p>
                        <span class="journal-read">Read article <Icon name="tabler:arrow-up-right" /></span>
                    </a>
                </article>
            ))}
        </div>
        {blogs.length === 0 && (
            <p class="journal-empty">{unavailable ? "Articles are unavailable right now. Please try again shortly." : "No articles here yet. Check back soon."}</p>
        )}
    </section>
</main>

<style>
    .journal-page { width: min(1280px, calc(100% - 80px)); margin: 0 auto; border-inline: 1px solid var(--craft-line); }
    .journal-hero { padding: 88px 40px 64px; }
    .journal-eyebrow { margin: 0 0 28px; color: var(--slate10); font: 11px var(--craft-mono); text-transform: uppercase; letter-spacing: .1em; }
    h1 { margin: 0 0 32px; color: var(--primary); font: 600 clamp(44px, 6vw, 80px) / 1.02 var(--craft-heading); letter-spacing: -.045em; }
    h1 em { display: block; color: var(--slate12); font-family: var(--craft-serif); font-size: 1.1em; font-weight: 400; }
    .journal-intro { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; }
    .journal-intro p { max-width: 640px; margin: 0; font-size: 18px; line-height: 1.7; color: var(--slate10); }
    .journal-intro a { display: inline-flex; align-items: center; gap: 10px; flex-shrink: 0; color: var(--slate12); font: 11px var(--craft-mono); text-transform: uppercase; letter-spacing: .06em; }
    .journal-intro a:hover { text-decoration: underline; text-underline-offset: 5px; }
    .journal-index { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 16px 40px; border-block: 1px solid var(--craft-line); }
    .journal-index h2, .journal-index a { margin: 0; font: 11px var(--craft-mono); text-transform: uppercase; letter-spacing: .08em; }
    .journal-index a { display: flex; align-items: center; gap: 8px; color: var(--slate10); }
    .journal-index a:hover { color: var(--slate12); }
    .journal-topics { display: flex; flex-wrap: wrap; gap: 8px; padding: 32px 40px; }
    .journal-topics a { padding: 10px 14px; border: 1px solid var(--craft-line); color: var(--slate10); font: 11px var(--craft-mono); text-transform: uppercase; letter-spacing: .04em; }
    .journal-topics a:hover { border-color: var(--slate12); color: var(--slate12); }
    .journal-topics a[aria-current="page"] { background: var(--slate12); color: var(--slate1); border-color: var(--slate12); }
    .journal-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; padding: 0 40px 48px; }
    .journal-card { min-width: 0; border: 1px solid var(--craft-line); transition: border-color .2s; }
    .journal-card:hover, .journal-card:focus-within { border-color: var(--slate10); }
    .journal-card > a { display: flex; flex-direction: column; height: 100%; padding: 28px; }
    .journal-card time { margin-bottom: 24px; color: var(--slate10); font: 11px var(--craft-mono); letter-spacing: .06em; text-transform: uppercase; }
    .journal-card h3 { margin: 0 0 16px; color: var(--slate12); font: 600 23px / 1.3 var(--craft-heading); letter-spacing: -.025em; overflow-wrap: break-word; }
    .journal-card p { margin: 0 0 28px; color: var(--slate10); font-size: 14px; line-height: 1.7; }
    .journal-read { display: flex; align-items: center; gap: 8px; margin-top: auto; color: var(--primary); font: 11px var(--craft-mono); text-transform: uppercase; letter-spacing: .06em; }
    .journal-read svg { margin-left: auto; width: 18px; height: 18px; transition: transform .2s; }
    .journal-card:hover .journal-read svg { transform: translate(2px, -2px); }
    .journal-empty { margin: 0; padding: 0 40px 64px; color: var(--slate10); }
    @media (max-width: 1100px) {
        .journal-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .journal-intro { align-items: flex-start; flex-direction: column; gap: 24px; }
    }
    @media (max-width: 800px) {
        .journal-page { width: calc(100% - 32px); }
        .journal-hero { padding: 64px 20px 48px; }
        .journal-index { padding-inline: 20px; }
        .journal-topics { padding: 24px 20px; }
        .journal-grid { padding: 0 20px 32px; gap: 14px; }
        .journal-card > a { padding: 24px; }
        .journal-card h3 { font-size: 21px; }
    }
    @media (max-width: 600px) {
        .journal-grid { grid-template-columns: minmax(0, 1fr); }
        .journal-intro p { font-size: 16px; }
        .journal-topics a { padding: 10px; font-size: 10px; }
        .journal-empty { padding-inline: 20px; }
    }
</style>
