---
import { Icon } from "astro-icon/components";
import { themes } from "../lib/themes";
---

<details class="craft-theme header-disclosure" id="theme-picker">
    <summary class="theme-toggle" aria-label="Change theme" title="Change theme">
        <Icon name="tabler:sun" />
    </summary>
    <div class="theme-options" aria-label="Color themes">
        <p>Choose a theme</p>
        {themes.map((theme) => (
            <button type="button" data-accent={theme.id} aria-pressed="false">
                <span class="theme-swatch" style={{ background: theme.background, borderColor: theme.primary }}></span>
                {theme.label}
                <Icon name="tabler:check" class="theme-check" />
            </button>
        ))}
    </div>
</details>

<script>
    import { themes } from "../lib/themes";

    function updateThemeButtons() {
        document.querySelectorAll<HTMLButtonElement>("#theme-picker button[data-accent]").forEach((button) => {
            button.setAttribute("aria-pressed", String(button.dataset.accent === document.documentElement.dataset.accent));
        });
    }

    document.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) return;
        const button = event.target.closest<HTMLButtonElement>("#theme-picker button[data-accent]");
        if (!button) return;
        const selected = themes.find((theme) => theme.id === button.dataset.accent);
        if (!selected) return;
        document.documentElement.dataset.accent = selected.id;
        document.documentElement.classList.toggle("dark", selected.dark);
        document.documentElement.style.colorScheme = selected.dark ? "dark" : "light";
        try { localStorage.setItem("accent", selected.id); } catch {}
        updateThemeButtons();
        const picker = document.querySelector<HTMLDetailsElement>("#theme-picker");
        if (picker) {
            picker.open = false;
            picker.querySelector("summary")?.focus();
        }
    });

    updateThemeButtons();
    document.addEventListener("astro:page-load", updateThemeButtons);
</script>
