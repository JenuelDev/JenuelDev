---
import { Icon } from "astro-icon/components";
import ThemeToggle from "./ThemeToggle.astro";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
    { href: "/", label: "Journal" },
    { href: "/programming", label: "Programming" },
    { href: "/finance", label: "Finance" },
];
---

<header class="craft-header">
    <a href="/" class="craft-logo" aria-label="JenuelDev blog home">
        <span class="site-logo-mark" aria-hidden="true"></span>
    </a>
    <nav class="craft-nav" aria-label="Main navigation">
        {links.map(({ href, label }) => (
            <a href={href} aria-current={pathname === href ? "page" : undefined}>{label}</a>
        ))}
        <a href="https://www.jenuel.dev/">Portfolio <Icon name="tabler:arrow-up-right" /></a>
        <a href="https://store.jenuel.dev/">Store <Icon name="tabler:arrow-up-right" /></a>
    </nav>
    <div class="craft-header-actions">
        <a class="header-github" href="https://github.com/JenuelDev" aria-label="GitHub">
            <Icon name="tabler:brand-github" />
        </a>
        <ThemeToggle />
        <a class="header-contact" href="https://www.jenuel.dev/contact">
            Get in touch <Icon name="tabler:arrow-up-right" />
        </a>
        <details class="mobile-navigation header-disclosure">
            <summary class="craft-menu-button" aria-label="Toggle navigation">
                <Icon name="tabler:menu-2" />
            </summary>
            <nav class="craft-mobile-menu" aria-label="Mobile navigation">
                {links.map(({ href, label }) => (
                    <a href={href} aria-current={pathname === href ? "page" : undefined}>{label}</a>
                ))}
                <a href="https://www.jenuel.dev/">Portfolio</a>
                <a href="https://store.jenuel.dev/">Store</a>
                <a href="https://www.jenuel.dev/contact">Get in touch</a>
            </nav>
        </details>
    </div>
</header>

<script>
    document.addEventListener("click", (event) => {
        if (!(event.target instanceof Node)) return;
        document.querySelectorAll<HTMLDetailsElement>(".header-disclosure[open]").forEach((menu) => {
            if (!menu.contains(event.target as Node)) menu.open = false;
        });
    });
    document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        document.querySelectorAll<HTMLDetailsElement>(".header-disclosure[open]").forEach((menu) => {
            menu.open = false;
            menu.querySelector("summary")?.focus();
        });
    });
</script>
